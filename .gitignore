# Local env file with real secrets. Never commit.
.env
.env.local
.env.*.local

# SSH keys, certificates, anything secret-shaped. Never commit.
*.pem
*.key
*-key
*-key.pub
*_key
*_key.pub
id_*
*.cert
*.crt

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# Node (in case anyone clones the upstream repo into here for local poking)
node_modules/
npm-debug.log*

# Local upstream clone used during template development.
.hermes-upstream/

# ---------------------------------------------------------------------------
# Runtime state. Git holds code and schema; the persistent disk holds data.
# Mixing them is how a redeploy ends up clobbering live campaign state.
# ---------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.db.bak*
agency.db
kanban.db
state.db
response_store.db
projects.db
cron/
sessions/
memories/
logs/
cache/
image_cache/
audio_cache/
sandboxes/
workspace/
plugin-data/
research_cache/
channel_directory.json
discord_threads.json
gateway_state.json
spawn-ledger.json
*.lock
*.pid

# Profile secrets. Every profile keeps its own; none of them belong here.
profiles/*/.env
.review.env
*.secrets
render.env*

# Build artifacts that duplicate a committed source file.
combined.sql
